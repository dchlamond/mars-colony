  "sources": [
    {
      "id": "horizons",
      "title": "Earth–Mars light time",
      "kind": "NASA/JPL calculation",
      "url": "https://ssd.jpl.nasa.gov/horizons/",
      "date": "2023-11-20",
      "text": "The saved Horizons record gives one-way light time in minutes. We approximate the signal-only round trip by doubling it, before human reply time. One training day advances the message clock by 20 minutes: a disclosed classroom shortcut, not the length of a Martian day."
    },
    {
      "id": "conjunction",
      "title": "Planning through solar conjunction",
      "kind": "Historical NASA operations",
      "url": "https://www.nasa.gov/solar-system/planets/mars/nasas-mars-fleet-will-still-conduct-science-while-lying-low/",
      "date": "2023-11",
      "text": "NASA paused Mars commanding during solar conjunction while preplanned science continued. Our scheduled radio pause is a training scenario. It does not turn off sunlight or cause the separately scheduled dust and radiation exercises."
    },
    {
      "id": "mola",
      "title": "A map measured by a laser",
      "kind": "NASA source plus model",
      "url": "https://trek.nasa.gov/mars/",
      "text": "MOLA elevation supplies the global map. Our height-to-air production formula and exaggerated local terrain are simplified models."
    },
    {
      "id": "rad",
      "title": "Radiation is not temperature",
      "kind": "Observation and teaching model",
      "url": "https://science.nasa.gov/resource/radiation-measurements-on-mars/",
      "text": "Curiosity RAD measures ionizing radiation. This mission compares a simulated relative exposure index: 100 outside and 30 at the shelter marker. These are not dose readings or NASA protection ratings."
    },
    {
      "id": "solar",
      "title": "Pointing panels toward the Sun",
      "kind": "Engineering principle plus game tuning",
      "url": "https://www.nasa.gov/smallsat-institute/sst-soa/power-subsystems/",
      "text": "Array orientation changes solar collection. The game charges 2 Parts and one technician day for a 20% boost lasting three production days; those quantities are game rules."
    },
    {
      "id": "water",
      "title": "Reuse water, but do not create it",
      "kind": "NASA principle plus game tuning",
      "url": "https://www.nasa.gov/missions/station/iss-research/nasa-achieves-water-recovery-milestone-on-international-space-station/",
      "text": "NASA demonstrated 98% recovery of collected water on the ISS. Our staffed processor recovers 95% of crew water; the simplified game still consumes fresh water."
    }
  ],
